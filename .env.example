# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional dataset API keys (only needed for the corresponding fetcher scripts)
BLS_API_KEY=
BEA_API_KEY=
FRED_API_KEY=

# Browser-use
BROWSER_USE_HEADLESS=true
# Browser Use Cloud — set to enable the stealth browser (proxy rotation, CAPTCHA solving).
# Without it, tools/browser.py runs a local headless Chromium, which BLS.gov/Bing/Google
# routinely block. Sign up at https://browser-use.com/
BROWSER_USE_API_KEY=
# Cap on concurrent browser-use sessions. The cloud free tier allows 3; paid
# plans allow more. We use this as a process-wide semaphore to avoid HTTP 429.
BROWSER_USE_MAX_CONCURRENCY=3

# Paths (override only if you want non-default locations)
DATA_DIR=./data
RUNS_DIR=./runs
DUCKDB_PATH=./data/main.duckdb
